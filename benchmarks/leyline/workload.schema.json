{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-ascend.example/schemas/leyline-workloads-v1.json",
  "title": "Leyline AMORTIZE validation workloads",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "prefix",
        "removed",
        "surviving",
        "query",
        "oracle"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "admissible",
            "counterfactual_admissible",
            "mechanism_diagnostic",
            "negative_control"
          ]
        },
        "prefix": {"type": "string"},
        "removed": {"type": "string", "minLength": 1},
        "removed_repeat": {"type": "integer", "minimum": 1, "default": 1},
        "surviving": {"type": "string", "minLength": 1},
        "surviving_repeat": {"type": "integer", "minimum": 1, "default": 1},
        "query": {"type": "string", "minLength": 1},
        "oracle": {"type": "object"},
        "counterfactual_removed": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
