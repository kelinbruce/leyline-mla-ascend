{
  "model": "deepseek-ai/DeepSeek-V2-Lite-Chat",
  "tokenizer": "deepseek-ai/DeepSeek-V2-Lite-Chat",
  "tokenizer_revision": "PIN_TOKENIZER_COMMIT",
  "trust_remote_code": true,
  "max_tokens": 64,
  "prompt_format": "chat_template",
  "evaluation": {
    "mode": "structured_json"
  },
  "preflight": {
    "prompt": "Return only this JSON: {\"ok\":true}",
    "oracle": {"ok": true},
    "max_tokens": 16
  },
  "diagnostics": {
    "top_logprobs": 10,
    "continue_after_preflight_failure": true,
    "device_capture_enabled": false,
    "raw_logits_capture_enabled": false
  },
  "performance_prerequisites": {
    "numerical_passed": false,
    "rollback_passed": false
  },
  "arms": {
    "full": "http://127.0.0.1:8000",
    "honest_edited": "http://127.0.0.1:8000",
    "patched_disabled": "http://127.0.0.1:8000",
    "vanilla_apc": "http://127.0.0.1:8000",
    "leyline": "http://127.0.0.1:8000"
  },
  "npu_memory_command": ["npu-smi", "info"]
}
